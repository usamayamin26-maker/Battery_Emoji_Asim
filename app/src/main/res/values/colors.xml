    <color name="ad_placeholder_skeleton">#FFE8E8EE</color>

    <!-- "Loading ad…" centred on a shimmer placeholder; muted against the skeleton behind it -->
    <color name="ad_loading_label">#66000000</color>

    <!-- "Ad Loading" dialog and the full-screen dialog's close button -->
    <color name="ad_dialog_text">#FF0D0D0D</color>
    <color name="ad_dialog_muted">#FF4B5563</color>
    <color name="ad_dialog_progress">#FF837DFF</color>

    <!-- Behind the large ad's 16:9 media, so a letterboxed creative sits on a neutral field -->
    <color name="ad_media_bg">#FF000000</color>

    <!-- Opaque backdrop drawn under a full-screen app open ad. Opaque in both modes on purpose:
         it exists to hide the screen behind the translucent AdActivity. -->
    <color name="ad_backdrop">#FF000000</color>

