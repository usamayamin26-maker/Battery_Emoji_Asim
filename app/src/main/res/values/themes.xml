<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.JHBatteryApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorSecondary">@color/primary_pink</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Global Application Font: Outfit -->
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
    </style>

    <style name="Theme.JHBatteryApp" parent="Base.Theme.JHBatteryApp" />

    <style name="Style_Rounded_Bottom_Sheet" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetDialogTheme</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="CircularImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="BottomSheetDialogTheme" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_shap</item>
    </style>
    <!-- Fullscreen Theme for Splash and Onboarding -->
    <style name="Theme.JHBatteryApp.Fullscreen" parent="Theme.JHBatteryApp">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Generic Dialog Theme for custom rounded dialogs -->
    <style name="Theme.JHBatteryApp.Dialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <!-- Generic BottomSheet Theme for rounded bottom sheets -->
    <style name="Theme.JHBatteryApp.BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_shap</item>
    </style>

    <style name="TextAppearance.Ad.LoadingLabel" parent="">
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="fontFamily">@font/outfit_medium</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="lineHeight">@dimen/_13ssp</item>
        <item name="android:textColor">@color/ad_loading_label</item>
    </style>
    <style name="ShapeAppearance.NativeAd.Icon" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
</resources>