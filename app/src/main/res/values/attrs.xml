<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom Attributes for BatteryEmojiCardView Component -->
    <declare-styleable name="EmojiBatteryCardView">
        <attr name="cardBackgroundColor" format="color" />
        <attr name="emojiTitle" format="string" />
        <attr name="emojiImage" format="reference" />
        <attr name="batteryPercentage" format="integer" />
        <attr name="batteryFillColor" format="color" />
        <attr name="cardCornerRadius" format="dimension" />
    </declare-styleable>

    <!-- Custom Attributes for the shared TopHeaderView (back button + title + optional action) -->
    <declare-styleable name="TopHeaderView">
        <attr name="headerTitle" format="string" />
        <attr name="showBack" format="boolean" />
        <attr name="actionIcon" format="reference" />
        <attr name="actionTint" format="color" />
    </declare-styleable>
</resources>
