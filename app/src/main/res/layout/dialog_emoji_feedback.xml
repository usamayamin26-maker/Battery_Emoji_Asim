<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="@dimen/_24sdp">

    <!-- White Card Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_24sdp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_22sdp"
        app:cardElevation="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_32sdp"
            android:paddingBottom="@dimen/_22sdp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_dialog_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:paddingHorizontal="@dimen/_8sdp"
                android:text="@string/feedback_dialog_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_10ssp" />

            <!-- 5 Emoji Reactions Horizontal Row -->
            <LinearLayout
                android:id="@+id/llEmojiReactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivEmojiAngry"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginHorizontal="@dimen/_4sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_reaction_angry" />

                <ImageView
                    android:id="@+id/ivEmojiSad"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginHorizontal="@dimen/_4sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_reaction_sad" />

                <ImageView
                    android:id="@+id/ivEmojiNeutral"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginHorizontal="@dimen/_4sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_reaction_neutral" />

                <ImageView
                    android:id="@+id/ivEmojiHappy"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginHorizontal="@dimen/_4sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_reaction_happy" />

                <!-- Love Emoji (Selected style with soft elevation container) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvEmojiLove"
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginHorizontal="@dimen/_4sdp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/_12sdp"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivEmojiLove"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/_3sdp"
                        android:src="@drawable/ic_reaction_love" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Reusable GradientButton for "Done" -->
            <com.asim.jhbatteryapp.presentation.components.GradientButton
                android:id="@+id/btnFeedbackDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                app:btnCornerRadius="@dimen/_20sdp"
                app:btnGradientEndColor="@color/primary_gradient_end"
                app:btnGradientStartColor="@color/primary_gradient_start"
                app:btnText="@string/done"
                app:btnTextColor="@color/white"
                app:btnTextSize="@dimen/_13ssp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Top Badge (Current selected reaction face) -->
    <ImageView
        android:id="@+id/ivFloatingTopEmoji"
        android:layout_width="@dimen/_48sdp"
        android:layout_height="@dimen/_48sdp"
        android:elevation="@dimen/_12sdp"
        android:src="@drawable/ic_reaction_neutral"
        app:layout_constraintBottom_toTopOf="@+id/cardDialogContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardDialogContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
