<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_notify_card"
    android:paddingHorizontal="@dimen/_16sdp"
    android:paddingTop="@dimen/_22sdp"
    android:paddingBottom="@dimen/_18sdp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvDontMissTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/dont_miss_out_title"
        android:textColor="#111827"
        android:textSize="@dimen/_17ssp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Don't Miss Out!!" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvDontMissDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/_2sdp"
        android:paddingHorizontal="@dimen/_10sdp"
        android:text="@string/dont_miss_out_desc"
        android:textColor="#6B7280"
        android:textSize="@dimen/_11ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDontMissTitle"
        tools:text="Turn on notifications to discover new Battery Icons, seasonal themes, and trending styles." />

    <!-- Center Illustration (Placeholder: User will add the artwork image) -->
    <ImageView
        android:id="@+id/ivDontMissIllustration"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_150sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/dont_miss"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDontMissDesc" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:id="@+id/llDontMissActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivDontMissIllustration">

        <!-- Left: Maybe Later -->
        <TextView
            android:id="@+id/btnDontMissLater"
            android:layout_width="0dp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_not_now"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/maybe_later"
            android:textColor="#8B5CF6"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

        <!-- Right: Turn On Notifications -->
        <TextView
            android:id="@+id/btnDontMissTurnOn"
            android:layout_width="0dp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_btn_allow_gradient"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/turn_on_notifications"
            android:textColor="@color/white"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
