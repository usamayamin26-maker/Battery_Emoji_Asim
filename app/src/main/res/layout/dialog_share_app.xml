<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="@dimen/_24sdp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/_22sdp"
    app:cardElevation="@dimen/_8sdp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_22sdp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share_dialog_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/_2sdp"
            android:text="@string/share_dialog_desc"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_11ssp" />

        <!-- Share Link Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:background="@drawable/bg_share_link_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_10sdp">

            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_link" />

            <TextView
                android:id="@+id/tvShareUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/share_link_url"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_11ssp" />

            <!-- Copy Button -->
            <TextView
                android:id="@+id/btnCopyLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_copy_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_4sdp"
                android:text="@string/copy"
                android:textColor="@color/primary_purple"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Reusable GradientButton for "Done" -->
        <com.asim.jhbatteryapp.presentation.components.GradientButton
            android:id="@+id/btnShareDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            app:btnCornerRadius="@dimen/_20sdp"
            app:btnGradientEndColor="@color/primary_gradient_end"
            app:btnGradientStartColor="@color/primary_gradient_start"
            app:btnText="@string/done"
            app:btnTextColor="@color/white"
            app:btnTextSize="@dimen/_13ssp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
