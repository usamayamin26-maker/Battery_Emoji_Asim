<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_floating_bottom_bar"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <!-- Tab 1: Trending -->
    <LinearLayout
        android:id="@+id/llTabTrending"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivTabTrending"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_heart" />

        <TextView
            android:id="@+id/tvTabTrending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_trending"
            android:textColor="@color/nav_item_active"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab 2: Customize -->
    <LinearLayout
        android:id="@+id/llTabCustomize"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivTabCustomize"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_layers" />

        <TextView
            android:id="@+id/tvTabCustomize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_customize"
            android:textColor="@color/nav_item_inactive"
            android:textSize="11sp"
            android:textStyle="normal" />
    </LinearLayout>

    <!-- Tab 3: Setting -->
    <LinearLayout
        android:id="@+id/llTabSetting"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivTabSetting"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_settings" />

        <TextView
            android:id="@+id/tvTabSetting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/nav_setting"
            android:textColor="@color/nav_item_inactive"
            android:textSize="11sp"
            android:textStyle="normal" />
    </LinearLayout>

</LinearLayout>
