<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Right Skip Button (Using sdp and ssp) -->
    <TextView
        android:id="@+id/tvSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_28sdp"
        android:layout_marginEnd="@dimen/_18sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_6sdp"
        android:text="@string/skip"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ViewPager2 for Onboarding Slides -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpOnboarding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Page Indicators (Using sdp) -->
    <LinearLayout
        android:id="@+id/llPageIndicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_16sdp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/btnGetStarted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/dot1"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_5sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:background="@drawable/bg_indicator_active" />

        <View
            android:id="@+id/dot2"
            android:layout_width="@dimen/_5sdp"
            android:layout_height="@dimen/_5sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:background="@drawable/bg_indicator_inactive" />

        <View
            android:id="@+id/dot3"
            android:layout_width="@dimen/_5sdp"
            android:layout_height="@dimen/_5sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:background="@drawable/bg_indicator_inactive" />
    </LinearLayout>

    <!-- REUSABLE COMPONENT: GradientButton for Onboarding (Using sdp and ssp) -->
    <com.asim.jhbatteryapp.presentation.components.GradientButton
        android:id="@+id/btnGetStarted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_28sdp"
        app:btnCornerRadius="@dimen/_14sdp"
        app:btnGradientEndColor="@color/primary_gradient_end"
        app:btnGradientStartColor="@color/primary_gradient_start"
        app:btnText="@string/get_started"
        app:btnTextColor="@color/white"
        app:btnTextSize="@dimen/_14ssp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
