<?xml version="1.0" encoding="utf-8"?>
<!-- Card plus the rate animation drawn on top of it (shown after Done with 4-5 stars) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRateContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/_22sdp"
        app:cardElevation="@dimen/_8sdp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingVertical="@dimen/_16sdp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedback_dialog_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/_2sdp"
                android:paddingHorizontal="@dimen/_8sdp"
                android:text="@string/feedback_dialog_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/_10ssp" />

            <!-- 5 Interactive Stars -->
            <LinearLayout
                android:id="@+id/llStarRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/star1"
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_star_filled" />

                <ImageView
                    android:id="@+id/star2"
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_star_filled" />

                <ImageView
                    android:id="@+id/star3"
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_star_filled" />

                <ImageView
                    android:id="@+id/star4"
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_star_outline" />

                <ImageView
                    android:id="@+id/star5"
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_star_outline" />
            </LinearLayout>

            <!-- Done Button -->
            <TextView
                android:id="@+id/btnRatingDone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/bg_btn_apply"
                android:clickable="true"
                android:elevation="@dimen/_2sdp"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/done"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Rate animation over the whole dialog (fitCenter keeps it uncropped); elevation above the card's so it draws on top -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieRateAnim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:elevation="@dimen/_12sdp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/rate_anim"
        tools:visibility="visible" />

</FrameLayout>
