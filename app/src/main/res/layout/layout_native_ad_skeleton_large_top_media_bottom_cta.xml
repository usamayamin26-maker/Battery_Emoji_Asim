<?xml version="1.0" encoding="utf-8"?>
<!--
    Skeleton for native_ad_large_top_media_bottom_cta.xml, inflated by NativeAdLoader into the
    layout_native_ad_shimmer_placeholder root (which supplies the card background and 10dp padding).
    Keep the 16:9 media ratio and the 110dp block in sync with native_ad_large_top_media_bottom_cta.xml.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/skeletonMedia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_ad_skeleton_bar"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        Centred on the media block rather than on the root. This root is the one skeleton measured
        wrap_content, so a child spanning it would feed its own height into that measurement; the
        media block is sized by its 16:9 ratio and the label sits wholly inside it, which leaves the
        skeleton's height exactly what it was.
    -->
    <TextView
        android:id="@+id/textAdLoadingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ad_loading_placeholder"
        android:textAppearance="@style/TextAppearance.Ad.LoadingLabel"
        app:layout_constraintBottom_toBottomOf="@id/skeletonMedia"
        app:layout_constraintEnd_toEndOf="@id/skeletonMedia"
        app:layout_constraintStart_toStartOf="@id/skeletonMedia"
        app:layout_constraintTop_toTopOf="@id/skeletonMedia" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skeletonMedia">

        <View
            android:id="@+id/skeletonIcon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_ad_skeleton_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/skeletonHeading"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_ad_skeleton_bar"
            app:layout_constraintBottom_toTopOf="@id/skeletonTag"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/skeletonIcon"
            app:layout_constraintTop_toTopOf="@id/skeletonIcon"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="160dp" />

        <View
            android:id="@+id/skeletonTag"
            android:layout_width="22dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ad_skeleton_bar"
            app:layout_constraintBottom_toBottomOf="@id/skeletonIcon"
            app:layout_constraintStart_toStartOf="@id/skeletonHeading"
            app:layout_constraintTop_toBottomOf="@id/skeletonHeading" />

        <View
            android:id="@+id/skeletonDescription"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="50dp"
            android:background="@drawable/bg_ad_skeleton_bar"
            app:layout_constraintBottom_toBottomOf="@id/skeletonTag"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/skeletonTag"
            app:layout_constraintTop_toTopOf="@id/skeletonTag" />

        <View
            android:id="@+id/skeletonButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_ad_skeleton_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
