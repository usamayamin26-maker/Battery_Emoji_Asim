<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Home Screen Fragment -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.jhw.batteryemoji.presentation.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_homeFragment_to_statusBarThemeFragment"
            app:destination="@id/statusBarThemeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_homeFragment_to_statusBarAnimationFragment"
            app:destination="@id/statusBarAnimationFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_homeFragment_to_statusBarCustomFragment"
            app:destination="@id/statusBarCustomFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_homeFragment_to_stickerDisplayFragment"
            app:destination="@id/stickerDisplayFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Search Screen Fragment -->
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.jhw.batteryemoji.presentation.search.SearchFragment"
        android:label="Search"
        tools:layout="@layout/fragment_search" />

    <!-- Settings Screen Fragment -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.jhw.batteryemoji.presentation.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <!-- Status Bar Theme Screen Fragment -->
    <fragment
        android:id="@+id/statusBarThemeFragment"
        android:name="com.jhw.batteryemoji.presentation.theme.StatusBarThemeFragment"
        android:label="Status Bar Theme"
        tools:layout="@layout/fragment_status_bar_theme" />

    <!-- Status Bar Animation Screen Fragment -->
    <fragment
        android:id="@+id/statusBarAnimationFragment"
        android:name="com.jhw.batteryemoji.presentation.animation.StatusBarAnimationFragment"
        android:label="Status Bar Animation"
        tools:layout="@layout/fragment_status_bar_animation">
        <action
            android:id="@+id/action_statusBarAnimationFragment_to_animationSeeAllFragment"
            app:destination="@id/animationSeeAllFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Animation See All Screen Fragment -->
    <fragment
        android:id="@+id/animationSeeAllFragment"
        android:name="com.jhw.batteryemoji.presentation.animation.AnimationSeeAllFragment"
        android:label="Animation Styles"
        tools:layout="@layout/fragment_animation_see_all" />

    <!-- Status Bar Custom Screen Fragment (linked with Customize bottom bar tab) -->
    <fragment
        android:id="@+id/statusBarCustomFragment"
        android:name="com.jhw.batteryemoji.presentation.custom.StatusBarCustomFragment"
        android:label="Status Bar Custom"
        tools:layout="@layout/fragment_status_bar_custom">
        <action
            android:id="@+id/action_statusBarCustomFragment_to_customIconDetailFragment"
            app:destination="@id/customIconDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Custom Icon Detail Screen Fragment -->
    <fragment
        android:id="@+id/customIconDetailFragment"
        android:name="com.jhw.batteryemoji.presentation.custom.CustomIconDetailFragment"
        android:label="Custom Icon Detail"
        tools:layout="@layout/fragment_custom_icon_detail">
        <argument
            android:name="iconId"
            android:defaultValue="airplane"
            app:argType="string" />
    </fragment>

    <!-- Sticker For Display Screen Fragment -->
    <fragment
        android:id="@+id/stickerDisplayFragment"
        android:name="com.jhw.batteryemoji.presentation.sticker.StickerDisplayFragment"
        android:label="Sticker For Display Screen"
        tools:layout="@layout/fragment_sticker_display" />

</navigation>
