<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and below. Nothing is backed up: restoring this app's preferences after a reinstall
   skipped Language/Onboarding and pointed at downloaded files and services that no longer exist.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
