<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle Top Glow / Gradient Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_22sdp" />
        </shape>
    </item>
    <!-- White Dialog Body (Inset 1.5dp on top/sides for delicate top border highlight) -->
    <item
        android:top="2dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="@dimen/_21sdp" />
        </shape>
    </item>
</layer-list>
