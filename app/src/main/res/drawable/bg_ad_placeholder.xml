<?xml version="1.0" encoding="utf-8"?>
<!-- Native ad card. Fill and outline colors are overridden at runtime by NativeAdStyler. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/native_ad_card_bg" />
    <stroke android:width="1dp" android:color="@color/native_ad_card_border" />
    <corners android:radius="12dp" />
</shape>
